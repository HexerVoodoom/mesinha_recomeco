<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Tema base do app (AppCompat, sem ActionBar — a UI é a WebView).
         Barras de status (topo) e navegação (base) em azul-tiffany. -->
    <style name="Theme.Mesinha" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="colorPrimary">@color/mesinha_teal</item>
        <item name="colorPrimaryDark">@color/mesinha_teal</item>
        <item name="colorAccent">@color/mesinha_teal_dark</item>
        <item name="android:windowBackground">@color/mesinha_cream</item>

        <!-- Barra de status (topo) -->
        <item name="android:statusBarColor">@color/mesinha_teal</item>
        <!-- Tiffany é claro: ícones escuros para contraste -->
        <item name="android:windowLightStatusBar">true</item>

        <!-- Barra de navegação (base) -->
        <item name="android:navigationBarColor">@color/mesinha_teal</item>
        <item name="android:windowLightNavigationBar">true</item>
    </style>
</resources>
