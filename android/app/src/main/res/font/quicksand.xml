<?xml version="1.0" encoding="utf-8"?>
<!--
  Quicksand — a mesma fonte dos títulos do app (Google Fonts, licença OFL).
  Os .ttf ficam versionados no repositório porque o widget precisa da fonte
  disponível offline: ele desenha sem o app aberto e sem rede.
-->
<font-family xmlns:android="http://schemas.android.com/apk/res/android">
    <font
        android:font="@font/quicksand_medium"
        android:fontStyle="normal"
        android:fontWeight="500" />
    <font
        android:font="@font/quicksand_bold"
        android:fontStyle="normal"
        android:fontWeight="700" />
</font-family>
