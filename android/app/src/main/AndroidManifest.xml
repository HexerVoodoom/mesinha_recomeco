<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- A WebView do app precisa de internet para carregar o PWA do Mesinha. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Reagendar a troca diária de frase após o boot. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- Gravação de áudio no Mural (getUserMedia dentro da WebView). -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- Notificações (Android 13+). -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Segura a CPU enquanto o widget Cutucar termina de enviar a cutucada. -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- Localização (aba Mapa: navigator.geolocation dentro da WebView). -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />

    <application
        android:name=".MesinhaApp"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Mesinha"
        android:usesCleartextTraffic="false">

        <!-- Tela principal: abre o PWA do Mesinha numa WebView. -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Widget 1: Corvinho + Alpaquinha conversando. -->
        <receiver
            android:name=".MesinhaWidgetProvider"
            android:exported="true"
            android:label="@string/widget_name_dupla">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <!-- Disparo customizado da virada do dia (à meia-noite). -->
                <action android:name="com.mesinha.app.ACTION_DAILY_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_dialogue_info" />
        </receiver>

        <!-- Widget 2: só a Alpaquinha (recado da Amanda para o Mateus). -->
        <receiver
            android:name=".AlpaquinhaWidgetProvider"
            android:exported="true"
            android:label="@string/widget_name_amanda">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="com.mesinha.app.ACTION_DAILY_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_alpaquinha_info" />
        </receiver>

        <!-- Widget 3: só o Corvinho (recado do Mateus para a Amanda). -->
        <receiver
            android:name=".CorvinhoWidgetProvider"
            android:exported="true"
            android:label="@string/widget_name_mateus">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="com.mesinha.app.ACTION_DAILY_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_corvinho_info" />
        </receiver>

        <!-- Widget 4: "Encontro hoje?" (1x1) — coração cheio/vazio conforme o Calendário de Encontros. -->
        <receiver
            android:name=".MeetupWidgetProvider"
            android:exported="true"
            android:label="@string/widget_name_meetup">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="com.mesinha.app.ACTION_DAILY_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_meetup_info" />
        </receiver>

        <!--
          Widget "Jardim" (2x2) — DESABILITADO por enquanto. O código
          (GardenWidgetProvider/GardenRepository, layout e strings) continua no
          repositório; pra religar é só descomentar este receiver e a linha do
          Jardim no BootReceiver.

        <receiver
            android:name=".GardenWidgetProvider"
            android:exported="true"
            android:label="@string/widget_name_garden">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="com.mesinha.app.ACTION_DAILY_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_garden_info" />
        </receiver>
        -->

        <!-- Widget: "Calendário do mês" (4x3) — mês atual com os dias de encontro marcados. -->
        <receiver
            android:name=".CalendarWidgetProvider"
            android:exported="true"
            android:label="@string/widget_name_calendar_month">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="com.mesinha.app.ACTION_DAILY_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_calendar_info" />
        </receiver>

        <!-- Widget: "Calendário da semana" (4x1) — a semana atual, com os dias de encontro marcados. -->
        <receiver
            android:name=".CalendarWeekWidgetProvider"
            android:exported="true"
            android:label="@string/widget_name_calendar_week">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="com.mesinha.app.ACTION_DAILY_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_calendar_week_info" />
        </receiver>

        <!-- Widget: "Cutucar" (1x1) — botão que envia a cutucada sem abrir o app. -->
        <receiver
            android:name=".PokeWidgetProvider"
            android:exported="true"
            android:label="@string/widget_name_poke">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="com.mesinha.app.ACTION_POKE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_poke_info" />
        </receiver>

        <!-- Tela de configuração do widget Cutucar (quem envia + mensagem). -->
        <activity
            android:name=".PokeConfigActivity"
            android:exported="true"
            android:label="@string/widget_poke_config_title">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_CONFIGURE" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <!-- Reagenda a troca diária quando o aparelho reinicia. -->
        <receiver
            android:name=".BootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

        <!-- Serviço do Firebase Cloud Messaging (recebe as notificações). -->
        <service
            android:name=".MesinhaMessagingService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>

        <!-- Canal padrão usado pelas notificações do FCM. -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_channel_id"
            android:value="mesinha_default" />
        <!-- Ícone padrão das notificações do FCM. -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_icon"
            android:resource="@drawable/ic_notification" />

    </application>

</manifest>
