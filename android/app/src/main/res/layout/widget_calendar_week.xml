<?xml version="1.0" encoding="utf-8"?>
<!--
  Widget "Calendário da semana" (4x1), no visual do app.

  Header de UMA linha de propósito: com o título e o período em linhas
  separadas (como no mensal), o conteúdo passava de 95dp num slot de ~72dp e o
  LinearLayout cortava justamente a linha dos números.

  Estrutura PLANA de propósito: linhas irmãs, sem LinearLayout por coluna.
  A versão com colunas aninhadas dava "não foi possível carregar o widget".
  Não volte a aninhar aqui.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_card_bg"
    android:gravity="center_vertical"
    android:orientation="vertical"
    android:paddingHorizontal="10dp"
    android:paddingVertical="6dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="13dp"
            android:layout_height="13dp"
            android:layout_marginEnd="5dp"
            android:contentDescription="@string/widget_calendar_title"
            android:src="@drawable/ic_heart_outline" />

        <TextView
            android:id="@+id/tv_week"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="@font/quicksand_bold"
            android:maxLines="1"
            android:ellipsize="end"
            android:text="@string/widget_calendar_week_preview"
            android:textColor="#2B2A28"
            android:textSize="11sp" />

    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/wl0"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="@font/quicksand_bold"
            android:gravity="center"
            android:text="D"
            android:textColor="#8A847D"
            android:textSize="10sp" />
        <TextView
            android:id="@+id/wl1"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="@font/quicksand_bold"
            android:gravity="center"
            android:text="S"
            android:textColor="#8A847D"
            android:textSize="10sp" />
        <TextView
            android:id="@+id/wl2"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="@font/quicksand_bold"
            android:gravity="center"
            android:text="T"
            android:textColor="#8A847D"
            android:textSize="10sp" />
        <TextView
            android:id="@+id/wl3"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="@font/quicksand_bold"
            android:gravity="center"
            android:text="Q"
            android:textColor="#8A847D"
            android:textSize="10sp" />
        <TextView
            android:id="@+id/wl4"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="@font/quicksand_bold"
            android:gravity="center"
            android:text="Q"
            android:textColor="#8A847D"
            android:textSize="10sp" />
        <TextView
            android:id="@+id/wl5"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="@font/quicksand_bold"
            android:gravity="center"
            android:text="S"
            android:textColor="#8A847D"
            android:textSize="10sp" />
        <TextView
            android:id="@+id/wl6"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="@font/quicksand_bold"
            android:gravity="center"
            android:text="S"
            android:textColor="#8A847D"
            android:textSize="10sp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/wd0"
            android:layout_width="0dp"
            android:layout_height="26dp"
            android:layout_weight="1"
            android:layout_marginHorizontal="2dp"
            android:layout_marginVertical="1dp"
            android:fontFamily="@font/quicksand_medium"
            android:gravity="center"
            android:text="1"
            android:textColor="#2B2A28"
            android:textSize="12sp" />
        <TextView
            android:id="@+id/wd1"
            android:layout_width="0dp"
            android:layout_height="26dp"
            android:layout_weight="1"
            android:layout_marginHorizontal="2dp"
            android:layout_marginVertical="1dp"
            android:fontFamily="@font/quicksand_medium"
            android:gravity="center"
            android:text="2"
            android:textColor="#2B2A28"
            android:textSize="12sp" />
        <TextView
            android:id="@+id/wd2"
            android:layout_width="0dp"
            android:layout_height="26dp"
            android:layout_weight="1"
            android:layout_marginHorizontal="2dp"
            android:layout_marginVertical="1dp"
            android:fontFamily="@font/quicksand_medium"
            android:gravity="center"
            android:text="3"
            android:textColor="#2B2A28"
            android:textSize="12sp" />
        <TextView
            android:id="@+id/wd3"
            android:layout_width="0dp"
            android:layout_height="26dp"
            android:layout_weight="1"
            android:layout_marginHorizontal="2dp"
            android:layout_marginVertical="1dp"
            android:fontFamily="@font/quicksand_medium"
            android:gravity="center"
            android:text="4"
            android:textColor="#2B2A28"
            android:textSize="12sp" />
        <TextView
            android:id="@+id/wd4"
            android:layout_width="0dp"
            android:layout_height="26dp"
            android:layout_weight="1"
            android:layout_marginHorizontal="2dp"
            android:layout_marginVertical="1dp"
            android:fontFamily="@font/quicksand_medium"
            android:gravity="center"
            android:text="5"
            android:textColor="#2B2A28"
            android:textSize="12sp" />
        <TextView
            android:id="@+id/wd5"
            android:layout_width="0dp"
            android:layout_height="26dp"
            android:layout_weight="1"
            android:layout_marginHorizontal="2dp"
            android:layout_marginVertical="1dp"
            android:fontFamily="@font/quicksand_medium"
            android:gravity="center"
            android:text="6"
            android:textColor="#2B2A28"
            android:textSize="12sp" />
        <TextView
            android:id="@+id/wd6"
            android:layout_width="0dp"
            android:layout_height="26dp"
            android:layout_weight="1"
            android:layout_marginHorizontal="2dp"
            android:layout_marginVertical="1dp"
            android:fontFamily="@font/quicksand_medium"
            android:gravity="center"
            android:text="7"
            android:textColor="#2B2A28"
            android:textSize="12sp" />
    </LinearLayout>

</LinearLayout>
