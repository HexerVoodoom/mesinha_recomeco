<?xml version="1.0" encoding="utf-8"?>
<!--
  Layout do widget 2x4 — etiqueta numa faixa própria no topo (NÃO sobrepõe),
  e abaixo a linha com personagens grandes + balões.
    [        CONVERSA DO DIA        ]
    [ CORVINHO ] [ balões ] [ ALPAQUINHA ]
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:orientation="vertical"
    android:padding="6dp">

    <!-- Etiqueta no topo, em faixa própria (não tampa o conteúdo) -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="3dp"
        android:background="@drawable/widget_label_bg"
        android:paddingHorizontal="10dp"
        android:paddingVertical="2dp"
        android:text="@string/widget_label"
        android:textColor="#3A8A8D"
        android:textSize="9sp"
        android:textStyle="bold"
        android:letterSpacing="0.08"
        android:fontFamily="sans-serif-medium" />

    <!-- Linha principal: personagem | balões | personagem (ocupa o resto) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:baselineAligned="false">

        <!-- Corvinho (esquerda) — preenche a altura disponível -->
        <ImageView
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1.35"
            android:adjustViewBounds="true"
            android:contentDescription="@string/corvinho"
            android:scaleType="fitCenter"
            android:src="@drawable/corvinho" />

        <!-- Balões (centro) -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1.8"
            android:gravity="center_vertical"
            android:orientation="vertical">

            <!-- Balão do Corvinho -->
            <TextView
                android:id="@+id/tv_corvinho"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="start"
                android:layout_marginBottom="5dp"
                android:background="@drawable/bubble_corvinho"
                android:paddingHorizontal="10dp"
                android:paddingVertical="5dp"
                android:textColor="#FFFFFF"
                android:textSize="11sp"
                android:textStyle="bold"
                android:fontFamily="sans-serif-medium"
                android:maxLines="3"
                android:ellipsize="end" />

            <!-- Balão da Alpaquinha -->
            <TextView
                android:id="@+id/tv_alpaquinha"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="end"
                android:background="@drawable/bubble_alpaquinha"
                android:paddingHorizontal="10dp"
                android:paddingVertical="5dp"
                android:textColor="#FFFFFF"
                android:textSize="11sp"
                android:textStyle="bold"
                android:textAlignment="textEnd"
                android:fontFamily="sans-serif-medium"
                android:maxLines="3"
                android:ellipsize="end" />
        </LinearLayout>

        <!-- Alpaquinha (direita) — preenche a altura disponível -->
        <ImageView
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1.35"
            android:adjustViewBounds="true"
            android:contentDescription="@string/alpaquinha"
            android:scaleType="fitCenter"
            android:src="@drawable/alpaquinha" />
    </LinearLayout>

</LinearLayout>
