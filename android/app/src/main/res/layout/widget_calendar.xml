<?xml version="1.0" encoding="utf-8"?>
<!--
  Widget "Calendário do mês" (4x3), espelhando o Calendário de Encontros do
  app: Quicksand, coração de contorno no header, mesma paleta e células
  quadradas com cantos arredondados, coloridas pelo estado.

  Pesos de fonte apontam o .ttf direto (quicksand_bold / quicksand_medium) em
  vez de font-family + textStyle: em API 26/27 a família pode sintetizar o
  negrito em vez de usar o arquivo 700.

  Células c0..c41 preenchidas pelo CalendarWidgetProvider; os textos padrão
  são a prévia da lista de widgets e o estado antes do primeiro desenho.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
