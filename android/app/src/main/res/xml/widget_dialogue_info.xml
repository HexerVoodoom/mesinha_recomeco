<?xml version="1.0" encoding="utf-8"?>
<!--
  Widget 2x4 (largura 4 células x altura 2 células) por padrão, mas que PRECISA
  poder ser reduzido a 1 célula de altura (layout compacto, ver
  MesinhaWidgetProvider). Como o launcher decide o mínimo:
    - Pixel/AOSP usam minResizeHeight.
    - POCO/MIUI e outros launchers de fabricante podem usar minHeight como piso,
      e com minHeight=110dp a linha mínima vira 2 células (o widget "trava").
  Por isso minHeight e minResizeHeight ficam os dois em 40dp. O tamanho inicial
  continua sendo 4x2 porque quem manda nele (Android 12+) é targetCell*.
  NÃO suba estes valores: já regrediu antes (80dp -> 40dp foi corrigido em 3a7d98c).
  Há um guarda no CI (.github/scripts/check-widget-sizes.sh) que falha se subirem.
-->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:minWidth="250dp"
    android:minHeight="40dp"
    android:targetCellWidth="4"
    android:targetCellHeight="2"
    android:minResizeWidth="180dp"
    android:minResizeHeight="40dp"
    android:resizeMode="horizontal|vertical"
    android:widgetCategory="home_screen"
    android:previewLayout="@layout/widget_dialogue"
    android:initialLayout="@layout/widget_dialogue"
    android:updatePeriodMillis="1800000" />
