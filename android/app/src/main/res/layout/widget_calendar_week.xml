<?xml version="1.0" encoding="utf-8"?>
<!--
  Widget "Calendário da semana" (4x1): a semana atual, no visual dos cards do
  app (fundo branco, cores do MeetupCalendar).

  Estrutura PLANA de propósito: três linhas irmãs, sem LinearLayout por coluna.
  A versão com colunas aninhadas dava "não foi possível carregar o widget" no
  aparelho, enquanto o mensal — que nunca aninhou — carregava normalmente.
  Não volte a aninhar aqui.

  Textos padrão: prévia da lista de widgets e estado antes do primeiro desenho.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_card_bg"
    android:gravity="center_vertical"
    android:orientation="vertical"
    android:paddingHorizontal="10dp"
    android:paddingVertical="8dp">

    <TextView
        android:id="@+id/tv_week"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="4dp"
        android:fontFamily="sans-serif-medium"
        android:gravity="center"
        android:maxLines="1"
        android:ellipsize="end"
        android:text="@string/widget_calendar_week_preview"
        android:textColor="#2B2A28"
        android:textSize="11sp"
        android:textStyle="bold" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/wl0"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="sans-serif-medium"
            android:gravity="center"
            android:text="D"
            android:textColor="#6F6960"
            android:textSize="10sp"
            android:textStyle="bold" />
        <TextView
            android:id="@+id/wl1"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="sans-serif-medium"
            android:gravity="center"
            android:text="S"
            android:textColor="#6F6960"
            android:textSize="10sp"
            android:textStyle="bold" />
        <TextView
            android:id="@+id/wl2"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="sans-serif-medium"
            android:gravity="center"
            android:text="T"
            android:textColor="#6F6960"
            android:textSize="10sp"
            android:textStyle="bold" />
        <TextView
            android:id="@+id/wl3"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="sans-serif-medium"
            android:gravity="center"
            android:text="Q"
            android:textColor="#6F6960"
            android:textSize="10sp"
            android:textStyle="bold" />
        <TextView
            android:id="@+id/wl4"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="sans-serif-medium"
            android:gravity="center"
            android:text="Q"
            android:textColor="#6F6960"
            android:textSize="10sp"
            android:textStyle="bold" />
        <TextView
            android:id="@+id/wl5"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="sans-serif-medium"
            android:gravity="center"
            android:text="S"
            android:textColor="#6F6960"
            android:textSize="10sp"
            android:textStyle="bold" />
        <TextView
            android:id="@+id/wl6"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="sans-serif-medium"
            android:gravity="center"
            android:text="S"
            android:textColor="#6F6960"
            android:textSize="10sp"
            android:textStyle="bold" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/wd0"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_margin="1dp"
            android:fontFamily="sans-serif-medium"
            android:gravity="center"
            android:paddingVertical="5dp"
            android:text="1"
            android:textColor="#2B2A28"
            android:textSize="12sp" />
        <TextView
            android:id="@+id/wd1"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_margin="1dp"
            android:fontFamily="sans-serif-medium"
            android:gravity="center"
            android:paddingVertical="5dp"
            android:text="2"
            android:textColor="#2B2A28"
            android:textSize="12sp" />
        <TextView
            android:id="@+id/wd2"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_margin="1dp"
            android:fontFamily="sans-serif-medium"
            android:gravity="center"
            android:paddingVertical="5dp"
            android:text="3"
            android:textColor="#2B2A28"
            android:textSize="12sp" />
        <TextView
            android:id="@+id/wd3"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_margin="1dp"
            android:fontFamily="sans-serif-medium"
            android:gravity="center"
            android:paddingVertical="5dp"
            android:text="4"
            android:textColor="#2B2A28"
            android:textSize="12sp" />
        <TextView
            android:id="@+id/wd4"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_margin="1dp"
            android:fontFamily="sans-serif-medium"
            android:gravity="center"
            android:paddingVertical="5dp"
            android:text="5"
            android:textColor="#2B2A28"
            android:textSize="12sp" />
        <TextView
            android:id="@+id/wd5"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_margin="1dp"
            android:fontFamily="sans-serif-medium"
            android:gravity="center"
            android:paddingVertical="5dp"
            android:text="6"
            android:textColor="#2B2A28"
            android:textSize="12sp" />
        <TextView
            android:id="@+id/wd6"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_margin="1dp"
            android:fontFamily="sans-serif-medium"
            android:gravity="center"
            android:paddingVertical="5dp"
            android:text="7"
            android:textColor="#2B2A28"
            android:textSize="12sp" />
    </LinearLayout>

</LinearLayout>
